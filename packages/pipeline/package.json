{
  "name": "@app/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "contract:live": "LIVE_CONTRACT=1 vitest run --project unit src/contract.test.ts"
  },
  "dependencies": {
    "@app/assistant": "workspace:*",
    "@app/db": "workspace:*",
    "@app/live": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/voice": "workspace:*",
    "@app/whatsapp": "workspace:*",
    "bullmq": "6.7.6",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@app/simulator": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
