{
  "name": "@app/live",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.2",
    "@app/assistant": "workspace:*",
    "@app/voice": "workspace:*",
    "@aws-sdk/client-bedrock-runtime": "3.1171.0",
    "@aws-sdk/client-polly": "3.1171.0",
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/client-transcribe": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
