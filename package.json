{
  "name": "support-desk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build:packages": "pnpm --filter './packages/*' build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "db:provision": "pnpm build:packages && pnpm --filter @app/db run provision",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm build:packages && NODE_OPTIONS=--max-old-space-size=4096 eslint . --max-warnings 0",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test && scripts/commit-msg-check.test.sh",
    "test:int": "pnpm build:packages && pnpm -r --workspace-concurrency=1 test:int"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
