# Copy to .env (`make setup` does this). Every variable the code reads is listed here.
# Values below are for local development only; production values live in SSM Parameter Store.

# --- Run mode -------------------------------------------------------------
# mock: every external system is faked locally (simulator, scripted model, local disk).
# live: calls Meta, Bedrock, Transcribe, Polly and S3. Unset means mock.
APP_MODE=mock
# NODE_ENV is deliberately not set here: Next.js, Vitest and the containers set
# it themselves, and exporting `development` to `next build` breaks the build.
# debug | info | warn | error
LOG_LEVEL=info

# --- Local infrastructure (Docker Compose) ---------------------------------
# Host ports for the Compose Postgres and Redis. Non-default so they do not
# collide with other Postgres/Redis instances on the machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- Services ---------------------------------------------------------------
# Postgres roles (see packages/db/src/setup.ts). Each service uses the least privileged one.
# app_user: the API and worker. Cannot bypass row-level security.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:55432/app
# app_platform: platform-admin views, only through narrow database functions.
DATABASE_PLATFORM_URL=postgres://app_platform:app_platform_dev@localhost:55432/app
# app_migrator: owns the schema; runs migrations and seeds.
DATABASE_MIGRATOR_URL=postgres://app_migrator:app_migrator_dev@localhost:55432/app
# Superuser: only to create the roles above (make db). Local and CI only, never production apps.
DATABASE_SUPERUSER_URL=postgres://postgres:postgres@localhost:55432/app
# Redis for queues and the readiness check (database 0).
REDIS_URL=redis://localhost:56379/0
API_PORT=4000
# Public origin of the web app. Session cookies and the CSRF origin check are bound to it.
PUBLIC_APP_URL=http://localhost:3000
# Where the web server reaches the API (Next.js rewrites /api/* here).
API_INTERNAL_URL=http://localhost:4000
# Signs session cookies. Dev value only; production uses SSM. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Password for the seeded demo users (make db). Defaults to counter-demo-2026 outside production.
SEED_PASSWORD=counter-demo-2026
# Extra generated conversations for Qamar Phone Corner (0 = none). 300 shows the long-list state.
SEED_BULK_CONVERSATIONS=0
WEB_PORT=3000
SIMULATOR_PORT=4010
# --- WhatsApp -------------------------------------------------------------------
# Graph API version for all calls (Meta changelog: v26.0 released 2026-07-29).
WHATSAPP_GRAPH_VERSION=v26.0
# Simulator numbers: the product calls the simulator's Graph API and receives
# its signed webhooks at /api/webhooks/whatsapp/simulator. Dev values only.
SIMULATOR_GRAPH_URL=http://localhost:4010
SIMULATOR_PUBLIC_URL=http://localhost:4010
SIMULATOR_WEBHOOK_URL=http://localhost:4000/api/webhooks/whatsapp/simulator
SIMULATOR_ACCESS_TOKEN=sim-access-token-dev
SIMULATOR_APP_SECRET=sim-app-secret-dev
SIMULATOR_VERIFY_TOKEN=sim-verify-token-dev
# Real numbers (live mode only; ignored in mock mode). From the Meta app and
# a system user; production values come from SSM.
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# How long a reply waits for the previous reply's delivered status (ms).
ORDER_HOLD_MS=10000
OUTBOUND_ATTEMPTS=6
OUTBOUND_BACKOFF_MS=1000
# Mock-mode object storage (live mode uses S3).
MEDIA_STORAGE_DIR=.data/media

# Next.js sends anonymous telemetry by default; mock mode must make no outbound calls.
NEXT_TELEMETRY_DISABLED=1

# --- Integration tests ------------------------------------------------------
# Tests use the roles above against a separate database, app_test, recreated on
# every run, and a separate Redis index so they never touch dev data.
TEST_REDIS_URL=redis://localhost:56379/1
