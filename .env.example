# Copy to .env (`make setup` does this). Every variable the code reads is listed here.
# Values below are for local development only; production values live in SSM Parameter Store.

# --- Run mode -------------------------------------------------------------
# mock: every external system is faked locally (simulator, scripted model, local disk).
# live: calls Meta, Bedrock, Transcribe, Polly and S3. Unset means mock.
APP_MODE=mock
# development | test | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- Local infrastructure (Docker Compose) ---------------------------------
# Host ports for the Compose Postgres and Redis. Non-default so they do not
# collide with other Postgres/Redis instances on the machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- Services ---------------------------------------------------------------
# Postgres roles (see packages/db/src/setup.ts). Each service uses the least privileged one.
# app_user: the API and worker. Cannot bypass row-level security.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:55432/app
# app_platform: platform-admin views, only through narrow database functions.
DATABASE_PLATFORM_URL=postgres://app_platform:app_platform_dev@localhost:55432/app
# app_migrator: owns the schema; runs migrations and seeds.
DATABASE_MIGRATOR_URL=postgres://app_migrator:app_migrator_dev@localhost:55432/app
# Superuser: only to create the roles above (make db). Local and CI only, never production apps.
DATABASE_SUPERUSER_URL=postgres://postgres:postgres@localhost:55432/app
# Redis for queues and the readiness check (database 0).
REDIS_URL=redis://localhost:56379/0
API_PORT=4000
WEB_PORT=3000
SIMULATOR_PORT=4010
# Next.js sends anonymous telemetry by default; mock mode must make no outbound calls.
NEXT_TELEMETRY_DISABLED=1

# --- Integration tests ------------------------------------------------------
# Tests use the roles above against a separate database, app_test, recreated on
# every run, and a separate Redis index so they never touch dev data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/app_test
TEST_REDIS_URL=redis://localhost:56379/1
